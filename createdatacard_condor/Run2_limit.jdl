Error  = ./condor_logs/Run2_v9/Limit_MX250_MH125_$(Process).err
Log  = ./condor_logs/Run2_v9/Limit_MX250_MH125_$(Process).log
Arguments = /eos/user/s/shsong /eos/user/s/shsong/unblind1_March/datacard_run2 MX250_MH125.txt MX250_MH125 /eos/user/s/shsong/unblind1_March/datacard_run2/
